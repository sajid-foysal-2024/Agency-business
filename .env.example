# Copy this file to ".env" (same folder as manage.py) and fill in the values.
# .env is git-ignored, so your password never goes to GitHub.

# Gmail account that SENDS the notification emails
EMAIL_HOST_USER=you@gmail.com
# 16-letter Gmail App Password (not your normal Gmail password)
EMAIL_HOST_PASSWORD=

# ---------------------------------------------------------------
# Payments
# sandbox = test only (Demo provider, no real money)
# live    = real payments: needs APPROVED merchant credentials, DEBUG off, https SITE_URL
# ---------------------------------------------------------------
PAYMENT_MODE=sandbox
SITE_URL=http://127.0.0.1:8000

# SSLCOMMERZ store credentials (sandbox ones from developer.sslcommerz.com/registration,
# live ones only after SSLCOMMERZ approves your merchant account)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Days until an invoice is due
INVOICE_DUE_DAYS=7

# Production basics
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=change-me-to-a-long-random-value
# DJANGO_ALLOWED_HOSTS=osagency.com,www.osagency.com
